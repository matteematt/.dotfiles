{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git name-rev:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git ls-remote:*)",
      "Bash(git cat-file:*)",
      "Bash(git grep:*)",
      "Bash(git diff-tree:*)",
      "Bash(git diff-index:*)",
      "Bash(git check-ignore:*)",
      "Bash(git check-attr:*)",
      "Bash(git count-objects:*)",
      "Bash(git verify-commit:*)",
      "Bash(git reflog)",
      "Bash(git reflog show:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show:*)",
      "Bash(git remote get-url:*)",
      "Bash(git branch)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch -v:*)",
      "Bash(git branch --all:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --contains:*)",
      "Bash(git branch --merged:*)",
      "Bash(git tag -l:*)",
      "Bash(git tag --list:*)",
      "Bash(git config --get:*)",
      "Bash(git config --get-all:*)",
      "Bash(git config --get-regexp:*)",
      "Bash(git config --list:*)",
      "Bash(git help:*)",
      "Bash(git version)",
      "Bash(git --version)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git update-ref:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git reflog expire:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
